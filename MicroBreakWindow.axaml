<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MoveBit.MicroBreakWindow"
        Title="微休息"
        Width="400"
        SizeToContent="Height"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        KeyDown="OnKeyDown">

    <!-- A gentle screen-center nudge: stand up, look far away. No lock, no sound,
         dismiss by click / Esc / timeout. Falls out of view on its own. -->
    <Border x:Name="Card" CornerRadius="18"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
            BoxShadow="0 10 28 0 #40000000"
            Margin="14" Padding="26,18" Cursor="Hand">
        <StackPanel Spacing="5">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="👀" FontSize="22" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" Text="站 20 秒，看看远处" FontSize="18"
                           FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="微休息不打断久坐计时 · 点一下或按 Esc 收起"
                       FontSize="11.5" Foreground="{DynamicResource InkMuted}" />
            <ProgressBar x:Name="ShrinkingBar" Minimum="0" Maximum="100" Value="100"
                         Height="4" CornerRadius="2" Margin="0,6,0,0"
                         Foreground="{DynamicResource Accent}"
                         Background="{DynamicResource TrackBg}" />
        </StackPanel>
    </Border>
</Window>
