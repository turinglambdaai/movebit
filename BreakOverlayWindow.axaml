<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shapes="clr-namespace:Avalonia.Controls.Shapes;assembly=Avalonia.Controls"
        x:Class="MoveBit.BreakOverlayWindow"
        Title="休息一下"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Panel>
        <!-- Night-sky gradient: the break screen is the product's moment, not a punishment. -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#F2141B2E" Offset="0" />
                    <GradientStop Color="#F21B1233" Offset="0.55" />
                    <GradientStop Color="#F20D1220" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22">
            <Image x:Name="DropIcon" Source="avares://MoveBit/Assets/icon.png" Width="64" Height="64"
                   HorizontalAlignment="Center" />

            <TextBlock x:Name="BreakTitle" Text="休息时间 ☕" FontSize="30" FontWeight="SemiBold"
                       Foreground="#F0EEE6" HorizontalAlignment="Center" />

            <!-- Countdown ring: one real arc whose sweep is driven by the same remaining time as the text. -->
            <Grid Width="300" Height="300" HorizontalAlignment="Center">
                <Ellipse x:Name="Halo" Width="300" Height="300" Stroke="#33E8B77A"
                         StrokeThickness="2" Fill="Transparent" />
                <Ellipse Width="270" Height="270" Stroke="#2A2840" StrokeThickness="10"
                         Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <shapes:Arc x:Name="ProgressRing" Width="270" Height="270" Stroke="#E8B77A"
                            StrokeThickness="10" StrokeLineCap="Round" StartAngle="-90" SweepAngle="360"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock x:Name="CountdownText" Text="5:00" FontSize="76" FontWeight="Bold"
                           Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock x:Name="RingSub" Text="分钟后解锁" FontSize="13"
                           Foreground="#8A84A0" HorizontalAlignment="Center"
                           VerticalAlignment="Bottom" Margin="0,0,0,58" />
            </Grid>

            <TextBlock x:Name="BreakHint" Text="站起来，晃晃肩膀" FontSize="18"
                       Foreground="#B8B2C7" HorizontalAlignment="Center" />

            <TextBlock x:Name="CycleText" Text="倒计时结束后自动解锁" FontSize="12.5"
                       Foreground="#6E6884" HorizontalAlignment="Center" Margin="0,2,0,0" />
        </StackPanel>

        <Button x:Name="SkipButton" Content="跳过，10 分钟后再提醒" Click="OnSkip"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,48"
                IsVisible="False" FontSize="13.5"
                Foreground="#8A849E" Background="Transparent" BorderBrush="#3A3550"
                Padding="16,7" CornerRadius="8" />
    </Panel>

    <Window.Styles>
        <!-- Breathing halo: a calm pulse instead of an aggressive blink. -->
        <Style Selector="Ellipse#Halo">
            <Style.Animations>
                <Animation Duration="0:0:4" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Button#SkipButton:pointerover">
            <Setter Property="Foreground" Value="#D8D4E4" />
            <Setter Property="BorderBrush" Value="#5A5478" />
        </Style>
    </Window.Styles>
</Window>
