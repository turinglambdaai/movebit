<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MoveBit.ViewModels"
        x:Class="MoveBit.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MoveBit"
        Width="520" Height="900"
        MinWidth="460" MinHeight="320"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBg}"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch">
        <StackPanel Margin="28,20" Spacing="18" HorizontalAlignment="Stretch">

            <!-- Two-column card layout: short enough to fit a laptop screen without
                 scrolling, and the ScrollViewer below stays as the small-screen fallback. -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Spacing="16">

            <!-- Today card -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="{DynamicResource Today.Title}" FontSize="13" Foreground="{DynamicResource InkSecondary}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{Binding StatusDotBrush}" />
                            <TextBlock Text="{Binding PauseText}" FontSize="12.5" Foreground="{Binding StatusDotBrush}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding ActiveTimeText}" FontSize="52" FontWeight="Bold"
                               Foreground="{DynamicResource InkPrimary}" Margin="0,-10,0,-4" />

                    <ProgressBar Minimum="0" Maximum="{Binding SitIntervalMax}" Value="{Binding SitCycleMinutes}"
                                 Height="9" CornerRadius="5" Foreground="{DynamicResource Accent}"
                                 Background="{DynamicResource TrackBg}" />

                    <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding SitCycleText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource InkPrimary}" />
                            <TextBlock Text="{DynamicResource Today.SitCycle}" FontSize="11" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="🚶" FontSize="14" />
                                <TextBlock Text="{Binding SitReminders}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Today.Sit}" FontSize="11" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="💧" FontSize="14" />
                                <TextBlock Text="{Binding WaterReminders}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Today.Water}" FontSize="11" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="👀" FontSize="14" />
                                <TextBlock Text="{Binding MicroBreaks}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Today.Micro}" FontSize="11" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- History card -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                        <Grid.Resources>
                            <!-- Fluent toggle checked state reads these theme keys directly, so a
                                 Background style setter never wins; alias them to the warm accent. -->
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#C25E3E"/>
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#B25134"/>
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#A3492D"/>
                                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFF8F3"/>
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Dark">
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#D97B54"/>
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#E28B66"/>
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#C96E4B"/>
                                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFF1E8"/>
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Grid.Resources>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HistoryRangeTitle}" FontSize="13" Foreground="{DynamicResource InkSecondary}" />
                            <TextBlock Text="{Binding HistoryTotalText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Content="{DynamicResource Hist.Toggle7}"
                                      IsChecked="{Binding IsWeekSelected, Mode=OneWay}"
                                      Click="OnHistoryWeekClicked" MinWidth="54" />
                        <ToggleButton Grid.Column="2" Content="{DynamicResource Hist.Toggle30}"
                                      IsChecked="{Binding IsMonthSelected, Mode=OneWay}"
                                      Click="OnHistoryMonthClicked" MinWidth="58" />
                    </Grid>

                    <Grid x:Name="HistoryChart" RowDefinitions="110,Auto,Auto" Margin="0,2,0,0">
                        <ItemsControl Grid.Row="0" ItemsSource="{Binding HistoryBars}" VerticalAlignment="Bottom">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding HistoryColumns}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Classes="daycol" Classes.today="{Binding IsToday}"
                                                VerticalAlignment="Bottom"
                                                Spacing="3" ToolTip.Tip="{Binding Tooltip}">
                                        <TextBlock Classes="barvalue" Text="{Binding MinutesText}"
                                                   IsVisible="{Binding ShowValue}" HorizontalAlignment="Center" />
                                        <Border Classes="bar" Width="{Binding BarWidth}" Height="{Binding BarHeight}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Daily-average reference line, translated up from the baseline -->
                        <Panel Grid.Row="0" VerticalAlignment="Bottom" IsVisible="{Binding ShowAvgLine}">
                            <Panel.RenderTransform>
                                <TranslateTransform Y="{Binding AvgLineTranslate}" />
                            </Panel.RenderTransform>
                            <StackPanel>
                                <TextBlock Classes="avglabel" Text="{Binding AvgLineText}"
                                           HorizontalAlignment="Right" Margin="0,0,2,3" />
                                <!-- Avalonia 11.3 Line.X1/X2 are not settable in XAML; a hairline Border reads fine at 1px -->
                                <Border Height="1" Background="{DynamicResource InkMuted}" Opacity="0.55" />
                            </StackPanel>
                        </Panel>

                        <Border Grid.Row="1" Height="1" Background="{DynamicResource CardBorder}" Margin="0,0,0,5" />

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding HistoryBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding HistoryColumns}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Classes="daylabel" Classes.today="{Binding IsToday}"
                                               Text="{Binding DayLabel}"
                                               HorizontalAlignment="Center" ToolTip.Tip="{Binding Tooltip}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Work-pattern insights -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource Insight.Title}" FontSize="13" Foreground="{DynamicResource InkSecondary}" />
                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="10">
                        <Border Grid.Row="0" Grid.Column="0" Classes="metric">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource Insight.Current}" FontSize="11" Foreground="{DynamicResource InkMuted}" />
                                <TextBlock Text="{Binding CurrentSessionText}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Classes="metric">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource Insight.TodayLongest}" FontSize="11" Foreground="{DynamicResource InkMuted}" />
                                <TextBlock Text="{Binding TodayLongestSessionText}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Classes="metric">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource Insight.RecentLongest}" FontSize="11" Foreground="{DynamicResource InkMuted}" />
                                <TextBlock Text="{Binding RecentLongestSessionText}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Classes="metric">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource Insight.RecentAvg}" FontSize="11" Foreground="{DynamicResource InkMuted}" />
                                <TextBlock Text="{Binding RecentAverageText}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                        <TextBlock Text="{DynamicResource Insight.Busiest}" FontSize="11.5" Foreground="{DynamicResource InkMuted}" />
                        <TextBlock Grid.Column="1" Text="{Binding BusiestDayText}" FontSize="11.5" Foreground="{DynamicResource InkPrimary}" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Text="{Binding SedentaryInsightText}" FontSize="11.5"
                               Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="16">

            <!-- Settings card -->
            <Border Classes="card">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                            <TextBlock Text="{DynamicResource Set.Title}" FontSize="13" Foreground="{DynamicResource InkSecondary}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding SettingsStatusText}" FontSize="11.5"
                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{DynamicResource Set.Intro}"
                                   FontSize="11" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Set.SitInterval}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource InkPrimary}" />
                        <NumericUpDown Grid.Column="1" Value="{Binding SitReminderMinutes}"
                                      Minimum="10" Maximum="240" Increment="5"
                                      HorizontalAlignment="Right" Width="132" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Set.WaterInterval}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource InkPrimary}" />
                        <NumericUpDown Grid.Column="1" Value="{Binding WaterReminderMinutes}"
                                      Minimum="5" Maximum="180" Increment="5"
                                      HorizontalAlignment="Right" Width="132" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Set.AwayReset}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource InkPrimary}" />
                        <NumericUpDown Grid.Column="1" Value="{Binding AwayResetMinutes}"
                                      Minimum="1" Maximum="60" Increment="1"
                                      HorizontalAlignment="Right" Width="132" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Set.Force}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource InkPrimary}" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ForceBreakEnabled}" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Set.BreakDuration}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource InkPrimary}" />
                        <NumericUpDown Grid.Column="1" Value="{Binding BreakDurationMinutes}"
                                      Minimum="1" Maximum="30" Increment="1"
                                      HorizontalAlignment="Right" Width="132" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Set.SkipDelay}" VerticalAlignment="Center" Foreground="{DynamicResource InkPrimary}" TextWrapping="Wrap" />
                        <NumericUpDown Grid.Column="1" Value="{Binding SkipAfterSeconds}"
                                      Minimum="0" Maximum="120" Increment="5"
                                      HorizontalAlignment="Right" Width="132" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Set.Snooze}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource InkPrimary}" />
                        <NumericUpDown Grid.Column="1" Value="{Binding SnoozeMinutes}"
                                      Minimum="5" Maximum="60" Increment="5"
                                      HorizontalAlignment="Right" Width="132" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Set.MicroToggle}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource InkPrimary}" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding MicroBreakEnabled}" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Set.MicroParams}" VerticalAlignment="Center" Foreground="{DynamicResource InkSecondary}" FontSize="12.5" TextWrapping="Wrap" />
                        <NumericUpDown Grid.Column="2" Value="{Binding MicroBreakIntervalMinutes}"
                                      Minimum="10" Maximum="60" Increment="5" Width="112" />
                        <NumericUpDown Grid.Column="3" Value="{Binding MicroBreakDurationSeconds}"
                                      Minimum="10" Maximum="60" Increment="5" Width="112" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Set.Sound}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource InkPrimary}" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SoundEnabled}" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Set.Autostart}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource InkPrimary}" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoStartEnabled}" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Set.Language}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource InkPrimary}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="0">
                            <ComboBox SelectedIndex="{Binding LanguageIndex}" MinWidth="132">
                                <ComboBoxItem Content="{DynamicResource Lang.Auto}" />
                                <ComboBoxItem Content="中文" />
                                <ComboBoxItem Content="English" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

                <!-- About / online update -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding VersionText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}" />
                                <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{Binding UpdateActionText}"
                                    IsEnabled="{Binding CanUpdateAction}"
                                    Click="OnUpdateClicked"
                                    VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource About.AutoUpdate}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource InkPrimary}" />
                                <TextBlock Text="{DynamicResource About.AutoUpdateHint}"
                                           FontSize="11" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCheckUpdates}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sync (Pro builds only; IsVisible is always false in the MIT build) -->
                <Border Classes="card" IsVisible="{Binding SyncSectionVisible}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{DynamicResource Sync.Title}" FontSize="13" Foreground="{DynamicResource InkSecondary}" />
                        <TextBlock Text="{Binding SyncStatusText}" FontSize="12" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding ConfigPathText}"
                       FontSize="11" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 2 8 0 #14000000" />
        </Style>
        <Style Selector="Border.metric">
            <Setter Property="Background" Value="{DynamicResource TrackBg}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Border.bar">
            <Setter Property="Background" Value="{DynamicResource ChartBar}" />
            <Setter Property="CornerRadius" Value="4,4,1,1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- Custom-class selectors must be dot-connected; ":today" parses as a pseudo-class and never matches. -->
        <Style Selector="Border.bar.today">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="TextBlock.barvalue">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        </Style>
        <Style Selector="StackPanel.daycol.today TextBlock.barvalue">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.daylabel">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
        </Style>
        <Style Selector="TextBlock.daylabel.today">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.avglabel">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        </Style>
    </Window.Styles>
</Window>
