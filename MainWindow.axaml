<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MoveBit.ViewModels"
        x:Class="MoveBit.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MoveBit"
        Width="440" Height="600"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height">

    <ScrollViewer>
        <StackPanel Margin="24,20" Spacing="16">

            <!-- Today card -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="今日" FontSize="14" Opacity="0.6" />
                    <TextBlock Text="{Binding ActiveTimeText}" FontSize="40" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="活跃工作时长" Opacity="0.7" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="久坐提醒 / 喝水提醒" Opacity="0" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding SitCycleText, StringFormat='本轮久坐 {0}'}" Opacity="0.7" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Opacity="0.7">
                            <Run Text="{Binding SitReminders}" /> 次 ·
                            <Run Text="{Binding WaterReminders}" /> 次
                        </TextBlock>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding PauseText}" Opacity="0.7" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Settings card -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Text="提醒设置" FontSize="14" Opacity="0.6" />

                    <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Grid.Column="0" Text="久坐提醒间隔（分钟）" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding SitReminderMinutes}"
                                      Minimum="10" Maximum="240" HorizontalAlignment="Right" Width="120" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Grid.Column="0" Text="喝水提醒间隔（分钟）" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding WaterReminderMinutes}"
                                      Minimum="5" Maximum="180" HorizontalAlignment="Right" Width="120" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Grid.Column="0" Text="离开多久算休息（分钟）" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding AwayResetMinutes}"
                                      Minimum="1" Maximum="60" HorizontalAlignment="Right" Width="120" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Grid.Column="0" Text="提醒时播放提示音" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SoundEnabled}" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Grid.Column="0" Text="久坐提醒接管全屏（强制休息）" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ForceBreakEnabled}" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Grid.Column="0" Text="强制休息时长（分钟）" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding BreakDurationMinutes}"
                                      Minimum="1" Maximum="30" HorizontalAlignment="Right" Width="120" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Grid.Column="0" Text="「跳过」按钮出现延迟（秒）" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding SkipAfterSeconds}"
                                      Minimum="0" Maximum="120" HorizontalAlignment="Right" Width="120" />
                    </Grid>
                </StackPanel>
            </Border>

            <Button Content="发送一条测试提醒" HorizontalAlignment="Stretch" Click="OnTestNotification" />

            <TextBlock Text="{Binding ConfigPathText, StringFormat='配置文件：{0}'}"
                       FontSize="11" Opacity="0.45" TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#F7F8FA" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="BoxShadow" Value="0 1 3 0 #14000000" />
        </Style>
    </Window.Styles>
</Window>
