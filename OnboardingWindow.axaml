<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MoveBit.OnboardingWindow"
        Title="{DynamicResource Ob.Title}"
        Width="500" Height="640"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBg}"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Grid RowDefinitions="*, Auto" Margin="32,28">

        <!-- Pages -->
        <Panel Grid.Row="0">

            <!-- Page 0: meet the droplet -->
            <StackPanel x:Name="Page0" Spacing="14">
                <Image Source="avares://MoveBit/Assets/icon.png" Width="84" Height="84"
                       HorizontalAlignment="Center" Margin="0,24,0,8" />
                <TextBlock Text="{DynamicResource Ob.Hello}" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource InkPrimary}" HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource Ob.Intro}"
                           FontSize="14.5" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap"
                           LineHeight="24" HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock Text="{DynamicResource Ob.Steps}" FontSize="13" Foreground="{DynamicResource InkMuted}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Page 1: strictness -->
            <StackPanel x:Name="Page1" IsVisible="False" Spacing="12">
                <TextBlock Text="{DynamicResource Ob.StrictTitle}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource InkPrimary}" />
                <TextBlock Text="{DynamicResource Ob.StrictQ}" FontSize="13" Foreground="{DynamicResource InkSecondary}" />

                <Border x:Name="ModeGentle" Classes="choice">
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{DynamicResource Ob.ModeGentle}" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}" />
                            <TextBlock Text="{DynamicResource Ob.ModeGentleHint}" FontSize="12" Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Ob.ModeGentleDesc}" FontSize="13" Foreground="{DynamicResource InkSecondary}" />
                    </StackPanel>
                </Border>

                <Border x:Name="ModeStandard" Classes="choice">
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{DynamicResource Ob.ModeStandard}" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}" />
                            <Border Classes="badge">
                                <TextBlock Text="{DynamicResource Ob.BadgeRecommended}" FontSize="11" Foreground="{DynamicResource Accent}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Ob.ModeStandardDesc}" FontSize="13" Foreground="{DynamicResource InkSecondary}" />
                    </StackPanel>
                </Border>

                <Border x:Name="ModeStrict" Classes="choice">
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{DynamicResource Ob.ModeStrict}" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}" />
                            <Border Classes="badge">
                                <TextBlock Text="{DynamicResource Ob.BadgeEvidence}" FontSize="11" Foreground="{DynamicResource OkGreen}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Ob.ModeStrictDesc}" FontSize="13" Foreground="{DynamicResource InkSecondary}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource Ob.StrictFootnote}"
                           FontSize="11.5" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Page 2: water & sound -->
            <StackPanel x:Name="Page2" IsVisible="False" Spacing="12">
                <TextBlock Text="{DynamicResource Ob.WaterTitle}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource InkPrimary}" />

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border x:Name="Water30" Classes="choice" Grid.Column="0">
                        <TextBlock Text="{DynamicResource Ob.Min30}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}" HorizontalAlignment="Center" />
                    </Border>
                    <Border x:Name="Water45" Classes="choice" Grid.Column="1">
                        <TextBlock Text="{DynamicResource Ob.Min45}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}" HorizontalAlignment="Center" />
                    </Border>
                    <Border x:Name="Water60" Classes="choice" Grid.Column="2">
                        <TextBlock Text="{DynamicResource Ob.Min60}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimary}" HorizontalAlignment="Center" />
                    </Border>
                </Grid>

                <Border Classes="card">
                    <Grid ColumnDefinitions="*, Auto" Margin="4,2">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{DynamicResource Ob.SoundTitle}" FontSize="14.5" Foreground="{DynamicResource InkPrimary}" />
                            <TextBlock Text="{DynamicResource Ob.SoundHint}" FontSize="11.5" Foreground="{DynamicResource InkMuted}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SoundToggle" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Page 3: the pact -->
            <StackPanel x:Name="Page3" IsVisible="False" Spacing="14">
                <TextBlock Text="{DynamicResource Ob.PactTitle}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource InkPrimary}" />
                <Border Classes="card">
                    <TextBlock x:Name="SummaryText" FontSize="14.5" Foreground="{DynamicResource InkSecondary}"
                               TextWrapping="Wrap" LineHeight="26" />
                </Border>
                <TextBlock Text="{DynamicResource Ob.PactOutro}" FontSize="13.5" Foreground="{DynamicResource InkMuted}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Panel>

        <!-- Footer: progress dots + actions -->
        <StackPanel Grid.Row="1" Spacing="16" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Ellipse x:Name="Dot0" Classes="dot" />
                <Ellipse x:Name="Dot1" Classes="dot" />
                <Ellipse x:Name="Dot2" Classes="dot" />
                <Ellipse x:Name="Dot3" Classes="dot" />
            </StackPanel>

            <Grid ColumnDefinitions="Auto, *">
                <Button x:Name="SkipButton" Grid.Column="0"
                        Classes="ghost" Click="OnSkip" FontSize="13" />
                <Button x:Name="NextButton" Grid.Column="1" Content="{DynamicResource Ob.Start}"
                        Click="OnNext" FontSize="14"
                        Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" BorderThickness="0"
                        CornerRadius="11" Padding="0,11" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
            </Grid>
        </StackPanel>
    </Grid>

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.choice">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- Plain classes need dot syntax; ':selected' parses as a pseudo-class and
             never matches — that exact bug shipped as "user can't select anything". -->
        <Style Selector="Border.choice.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        </Style>
        <Style Selector="Border.choice:pointerover:not(.selected)">
            <Setter Property="Background" Value="{DynamicResource GhostHover}" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource GhostBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,9" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource GhostHover}" />
        </Style>
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource InkMuted}" />
        </Style>
        <Style Selector="Ellipse.dot.active">
            <Setter Property="Fill" Value="{DynamicResource Accent}" />
            <Setter Property="Width" Value="22" />
        </Style>
    </Window.Styles>
</Window>
